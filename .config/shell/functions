#!/usr/bin/env bash

ex() {
  if [ -f "$1" ] ; then
    case "$1" in
      *.tar.bz2)   tar xjf "$1"   ;;
      *.tar.gz)    tar xzf "$1"   ;;
      *.tar.xz)    tar xJf "$1"   ;;
      *.tar.zst)   tar --zstd -xf "$1" ;;
      *.bz2)       bunzip2 "$1"   ;;
      *.gz)        gunzip "$1"    ;;
      *.tar)       tar xf "$1"    ;;
      *.zip)       unzip "$1"     ;;
      *.7z)        7z x "$1"      ;;
      *)           echo "'$1' is not in supported format" ;;
    esac
  else
    echo "'$1' is not a valid file"
  fi
}

mkcd() {
    mkdir -p "$1" && cd "$1" || return 1
}

mkscript() {
    touch "$1" && echo '#!/usr/bin/env bash' > "$1" && $EDITOR "$1" || return 1
}
